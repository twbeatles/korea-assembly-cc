#!/usr/bin/env sh
# 푸시 전 품질 게이트: pyright 0 errors
# 설치: python scripts/install_git_hooks.py

set -e
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT="."
cd "$ROOT" || exit 1

echo "[pre-push] pyright 검사 중..."
if command -v python >/dev/null 2>&1; then
  PYTHON=python
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
else
  echo "[pre-push] python 을 찾을 수 없습니다." >&2
  exit 1
fi

"$PYTHON" scripts/check_before_push.py --pyright-only
echo "[pre-push] pyright 통과"
